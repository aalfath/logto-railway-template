{
	admin off
	auto_https off
	servers {
		# Only Railway's edge can reach this service, so keep its X-Forwarded-* headers.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		# LOGTO_ADMIN_UPSTREAM = <Logto private domain>:3002
		reverse_proxy {$LOGTO_ADMIN_UPSTREAM}
	}
}
